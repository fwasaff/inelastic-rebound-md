# ==============================================================================
# in.bounce_cluster
# Impacto de un nanocúmulo LJ pre-minimizado sobre superficie FCC, NVE.
#
# Generaliza in.bounce_reprod para N variable: en vez de crear la bola con
# create_atoms+region, lee el cluster desde un archivo de datos LAMMPS
# pre-minimizado, centrado en el origen, con átomos tipo 2.
#
# Uso:
#   lmp -in lammps/in.bounce_cluster \
#       -var cluster_file lammps/clusters/cluster_N1_min.dat \
#       -var h0 11.03
#
# Variables configurables:
#   cluster_file : ruta al archivo .dat del cluster pre-minimizado
#   h0           : altura inicial del CM de la bola sobre la superficie [sigma]
#   g            : gravedad [sigma/tau^2]
#   bc_xy        : p (periódico, defecto) o s (shrink-wrap, superficie libre en
#                  x,y — sin envoltura periódica; el frente elástico se refleja
#                  en el borde en vez de reaparecer por el lado opuesto)
# ==============================================================================

# --- Configuración global -----------------------------------------------------
units           lj
atom_style      atomic
newton          on

# --- Variables ----------------------------------------------------------------
variable    bc_xy         index p
boundary        ${bc_xy} ${bc_xy} f
variable    cluster_file  index lammps/clusters/cluster_N1_min.dat
variable    h0            index 11.03
variable    g             index 0.026
variable    c_ps          index 0
variable    a0            equal 1.5496
variable    Nx            index 8
variable    Ny            index 8
variable    Nz            index 6
variable    dt            index 0.005
variable    thermo_freq   equal 100
variable    print_freq    equal 20
variable    t_total       index 400.0
variable    steps_total   equal round(v_t_total/v_dt)

# --- Caja y superficie --------------------------------------------------------
lattice         fcc $(4.0/(v_a0*v_a0*v_a0))
region          box_surf block 0 ${Nx} 0 ${Ny} 0 ${Nz} units lattice
create_box      2 box_surf
create_atoms    1 box

mass            1 1.0
mass            2 1.0

# Extender caja en z para la trayectoria de la bola
variable    z_surf_top  equal $(zhi)
variable    z_ball_cm   equal $(v_z_surf_top + v_h0)
variable    z_box_top   equal $(v_z_ball_cm + 10.0)
change_box  all z final -0.5 ${z_box_top} units box

# --- Leer cluster pre-minimizado y posicionar ---------------------------------
# El cluster está centrado en el origen. Lo desplazamos al centro de la caja
# en x,y y a la altura h0 sobre la superficie en z.
variable    Lx  equal xhi-xlo
variable    Ly  equal yhi-ylo

# Potenciales: definir ANTES de read_data (nocoeff ignora Pair Coeffs del archivo).
# c_ps=0: bola-superficie repulsivo puro (tabla); c_ps=1: LJ completo (adhesión).
if "${c_ps} == 0" then &
    "pair_style hybrid lj/cut 2.5 table linear 5000" &
    "pair_coeff 1 1 lj/cut 1.0 1.0 2.5" &
    "pair_coeff 2 2 lj/cut 1.0 1.0 2.5" &
    "pair_coeff 1 2 table table_repulsiva.txt REPULSIVE_LJ" &
else &
    "pair_style lj/cut 2.5" &
    "pair_coeff 1 1 1.0 1.0 2.5" &
    "pair_coeff 2 2 1.0 1.0 2.5" &
    "pair_coeff 1 2 1.0 1.0 2.5"

# LJ truncado Y desplazado: sin shift, cada par que cruza rc salta ±U(rc) en la
# energía contabilizada (~0.016 eps) y el balance VB/PE_surf acumula un error
# de 2-6% de E0 por impacto. El shift no altera fuerzas ni trayectorias.
pair_modify shift yes

read_data   ${cluster_file} add append nocoeff shift $(v_Lx/2) $(v_Ly/2) ${z_ball_cm}

# --- Grupos -------------------------------------------------------------------
group       surface type 1
group       ball    type 2

variable    z_fixed_top equal 2.0
region      reg_fixed block INF INF INF INF 0 ${z_fixed_top} units lattice
group       fixed_surf  region reg_fixed
group       mobile_surf subtract surface fixed_surf

# --- Rotación opcional de la bola (promedio sobre orientaciones) ---------------
# ax,ay,az: ángulos (grados) de rotación sucesiva de la bola en torno a su
# propio centro, en los ejes x, y, z. Defecto 0 → orientación cristalina
# original (runs previos idénticos). Se aplica antes de la minimización de la
# superficie, de modo que la geometría interna (mínimo en vacío) se conserva.
variable    ax   index 0.0
variable    ay   index 0.0
variable    az   index 0.0
variable    bcx  equal xcm(ball,x)
variable    bcy  equal xcm(ball,y)
variable    bcz  equal xcm(ball,z)
if "${ax} != 0.0" then "displace_atoms ball rotate ${bcx} ${bcy} ${bcz} 1 0 0 ${ax} units box"
if "${ay} != 0.0" then "displace_atoms ball rotate ${bcx} ${bcy} ${bcz} 0 1 0 ${ay} units box"
if "${az} != 0.0" then "displace_atoms ball rotate ${bcx} ${bcy} ${bcz} 0 0 1 ${az} units box"

# --- Minimización T=0 ---------------------------------------------------------
# El cluster ya está minimizado en aislamiento; solo minimizamos la superficie.
# La bola se mantiene fija durante la minimización de la superficie.
# etol=0 (no 1e-6): con losas grandes (Nx,Ny~80, ~1.5e5 átomos) la energía
# total es tan grande que un cambio relativo de 1e-6 entre pasos ya la
# satisface aunque las fuerzas sigan altas (visto: force two-norm 405->357 en
# solo 2 iteraciones) -- corta la minimización antes de que la superficie
# libre alcance a relajar, dejando tensión residual que se ve como vibración
# ambiente espuria desde t=0. Con etol=0 el criterio de parada es solo ftol
# (fuerza) o los topes de iteración/evaluación, que sí escalan bien con N.
fix         f_fix_bot   fixed_surf  setforce 0.0 0.0 0.0
fix         f_tmp_ball  ball        setforce 0.0 0.0 0.0
minimize    0.0 1.0e-8 20000 200000
unfix       f_tmp_ball
unfix       f_fix_bot

velocity    all set 0.0 0.0 0.0

# --- Variables derivadas de energía -------------------------------------------
variable    N_ball  equal count(ball)
variable    M_ball  equal v_N_ball*1.0
variable    M_surf  equal count(surface)*1.0

variable    Zcm   equal  xcm(ball,z)
variable    Vcmz  equal  vcm(ball,z)
variable    Vcmx  equal  vcm(ball,x)
variable    Vcmy  equal  vcm(ball,y)

variable    KB    equal  0.5*v_M_ball*v_Vcmz^2
variable    KB3d  equal  0.5*v_M_ball*(v_Vcmx^2+v_Vcmy^2+v_Vcmz^2)

compute     ball_ke   ball    ke
compute     surf_ke   surface ke
compute     Uc        ball    group/group surface
compute     pe_atom   all     pe/atom
compute     pe_ball   ball    reduce sum c_pe_atom
compute     pe_surf_r surface reduce sum c_pe_atom

variable    TB    equal  c_ball_ke-v_KB3d
variable    VB    equal  c_pe_ball-0.5*c_Uc
variable    UF    equal  v_M_ball*${g}*v_Zcm

variable    Vcmz_surf  equal  vcm(surface,z)
variable    Vcmx_surf  equal  vcm(surface,x)
variable    Vcmy_surf  equal  vcm(surface,y)
variable    KS         equal  0.5*v_M_surf*(v_Vcmx_surf^2+v_Vcmy_surf^2+v_Vcmz_surf^2)

variable    KS_out      equal  c_surf_ke
variable    PE_surf_out equal  c_pe_surf_r
variable    Uc_out      equal  c_Uc
variable    time        equal  step*${dt}

# --- Capa absorbente opcional (esponja) ----------------------------------------
# Sin esto, un frente elástico se refleja en un borde libre (bc_xy=s) o vuelve
# por la imagen periódica (bc_xy=p) antes de disiparse -- ver
# scripts/analizar_ondas_superficie.py. La esponja amortigua la velocidad
# (fix viscous, F=-gamma*v; sin ruido térmico, a diferencia de fix langevin)
# en 5 anillos concéntricos centrados en el punto de impacto (Lx/2,Ly/2), con
# gamma en RAMPA CUADRÁTICA gamma_k = gamma_max*(k/5)^2. La rampa gradual (en
# vez de un escalón) es lo que evita que la entrada de la esponja refleje --
# mismo principio que una capa perfectamente acoplada (PML): la impedancia
# cambia despacio, así el frente "no nota" el borde de la esponja y entra sin
# rebotar, y luego se apaga contra la pared. Empieza en r0_frac*(Lx/2).
# NOTA: fix viscous no conserva energía a propósito (la disipa) -- con
# sponge=1 el cierre Sum(alpha)=1 de bounce.dat deja de valer; usar sponge
# solo para el diagnóstico de ondas, no para las corridas de partición.
#
# `units box` es OBLIGATORIO en las cinco `region cylinder`. El defecto de
# `region` es `units lattice` (docs.lammps.org/region.html: "The option
# defaults are side = in, units = lattice"), y en un cilindro escala tanto
# c1,c2 como el RADIO. Como Lx=xhi-xlo ya está en sigma, sin `units box` todo
# se multiplicaba por a0=1.5496: el centro caía en (96.10,96.10) en vez de
# (62.01,62.01) y el punto de impacto quedaba DENTRO del primer anillo
# amortiguado (gamma=0.32), azimutalmente asimétrico. Eso invalidó por completo
# la corrida ondas_N79_esponja_v2 (jul 2026) sin dar ni un aviso: LAMMPS acepta
# las regiones y corre. Detectado el 2026-08-09 comparando los conteos de
# átomos por grupo del log contra los dos escalados (g0: 45204 medido, 45327
# predicho con lattice, 24772 con box). De ahí el bloque de verificación de
# abajo: el log tiene que llevar los conteos para que el error sea visible.
variable    sponge     index 0
variable    r0_frac    index 0.45
variable    gamma_max  index 8.0
if "${sponge} == 1" then &
    "variable  R_edge  equal v_Lx/2" &
    "variable  R0      equal v_r0_frac*v_R_edge" &
    "variable  dR      equal (v_R_edge-v_R0)/5.0" &
    "region    dsk0 cylinder z $(v_Lx/2) $(v_Ly/2) $(v_R0)        EDGE EDGE units box" &
    "region    dsk1 cylinder z $(v_Lx/2) $(v_Ly/2) $(v_R0+v_dR)   EDGE EDGE units box" &
    "region    dsk2 cylinder z $(v_Lx/2) $(v_Ly/2) $(v_R0+2*v_dR) EDGE EDGE units box" &
    "region    dsk3 cylinder z $(v_Lx/2) $(v_Ly/2) $(v_R0+3*v_dR) EDGE EDGE units box" &
    "region    dsk4 cylinder z $(v_Lx/2) $(v_Ly/2) $(v_R0+4*v_dR) EDGE EDGE units box" &
    "group     g0 region dsk0" &
    "group     g1 region dsk1" &
    "group     g2 region dsk2" &
    "group     g3 region dsk3" &
    "group     g4 region dsk4" &
    "group     ring1r subtract g1 g0" &
    "group     ring2r subtract g2 g1" &
    "group     ring3r subtract g3 g2" &
    "group     ring4r subtract g4 g3" &
    "group     ring1 intersect ring1r mobile_surf" &
    "group     ring2 intersect ring2r mobile_surf" &
    "group     ring3 intersect ring3r mobile_surf" &
    "group     ring4 intersect ring4r mobile_surf" &
    "group     ring5 subtract mobile_surf g4" &
    "fix       f_sp1 ring1 viscous $(v_gamma_max*0.04)" &
    "fix       f_sp2 ring2 viscous $(v_gamma_max*0.16)" &
    "fix       f_sp3 ring3 viscous $(v_gamma_max*0.36)" &
    "fix       f_sp4 ring4 viscous $(v_gamma_max*0.64)" &
    "fix       f_sp5 ring5 viscous ${gamma_max}" &
    "print     'ESPONJA 5 anillos cuadratica: R0=${R0} dR=${dR} R_edge=${R_edge} gamma_max=${gamma_max}'" &
    "variable  f_esp_pred equal PI*v_R0*v_R0/(v_Lx*v_Ly)" &
    "variable  f_esp_med  equal count(g0)/count(surface)" &
    "print     'ESPONJA check: fraccion de area de g0 esperada=${f_esp_pred} medida=${f_esp_med}'" &
    "print     'ESPONJA check: si no coinciden a ~2%, las regiones estan mal escaladas (units)'"

# --- Dinámica NVE -------------------------------------------------------------
fix         f_freeze_fixed  fixed_surf  setforce 0.0 0.0 0.0
fix         f_nve           all         nve
fix         f_wall_bot  mobile_surf  wall/reflect zlo EDGE
fix         f_wall_ball ball         wall/reflect zlo EDGE
fix         f_grav      ball         gravity ${g} vector 0 0 -1

# --- Salida -------------------------------------------------------------------
timestep    ${dt}
thermo      ${thermo_freq}
thermo_style custom step time v_Zcm v_Vcmz v_KB v_TB v_VB c_Uc v_UF etotal
thermo_modify norm no lost warn flush yes

fix print_energy all print ${print_freq} &
    "${time} ${Zcm} ${Vcmz} ${KB} ${TB} ${VB} ${Uc_out} ${UF} ${KB3d} ${KS_out} ${PE_surf_out}" &
    file bounce.dat &
    title "# time Zcm Vcmz KB TB VB Uc UF KB3d KS PE_surf" &
    screen no

# --- Dump opcional para visualización (OVITO/ParaView) -------------------------
# dump_freq=0 (defecto) desactiva; dump_freq=50 → 1 frame cada 0.25 tau (dt=0.005)
variable    dump_freq     index 0
if "${dump_freq} > 0" then &
    "compute keratom all ke/atom" &
    "dump viz all custom ${dump_freq} traj.lammpstrj id type x y z vx vy vz c_keratom c_pe_atom" &
    "dump_modify viz sort id"

# --- Correr -------------------------------------------------------------------
run     ${steps_total}

print "======================================================="
print "BOUNCE CLUSTER COMPLETO"
print "cluster_file = ${cluster_file}"
print "N_ball = $(count(ball)) atoms"
print "h0 = ${h0} sigma"
print "======================================================="
