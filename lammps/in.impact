# ==============================================================================
# in.impact
# Inelastic Rebound MD - Phase 2: Projectile Impact Simulation
#
# Physics:
#   A single LJ atom (projectile) is launched toward the equilibrated
#   FCC Argon surface at controlled incident velocity v0. After impact,
#   the projectile rebounds with velocity v_f < v0 (inelastic collision).
#
#   Coefficient of Restitution (COR):
#     e = |v_f_z| / |v0_z|   (normal component only)
#
#   Energy dissipation:
#     dE = (1/2)*m*(v0^2 - v_f^2)
#     -> transferred to surface phonons (measurable as DeltaT)
#
#   The simulation captures:
#     1. Impact dynamics (approach, contact, rebound)
#     2. Energy partition (projectile KE vs. surface thermal energy)
#     3. Surface deformation (if any, for high v0)
#
# Parameters to vary (parametric study):
#   v0     : incident normal velocity [sigma/tau]
#   T_surf : surface temperature [eps/kB]
#   angle  : impact angle (requires decomposing v0)
#
# Reference:
#   Glosli & McClelland, PRL 70, 1960 (1993)
#   Harrison et al., J. Chem. Phys. 97, 6573 (1992)
#
# Run with: lmp -in in.impact -var v0 2.0 -var angle 0.0
# Output:   dump.impact.lammpstrj, thermo_impact.dat, rebound_data.dat
# ==============================================================================

# --- Global settings ----------------------------------------------------------
units           lj
atom_style      atomic
boundary        p p f
newton          on

# --- Input variables (overridable from command line) --------------------------
variable    v0          index 2.0      # incident speed [sigma/tau] (default)
variable    angle       index 0.0      # impact angle from normal [degrees]
variable    T_target    index 0.1      # surface temperature [eps/kB]
variable    T_damp      index 1.0      # NVT damping time [tau]
variable    dt          index 0.002    # timestep [tau] (smaller for impact)
variable    z_gap       index 8.0      # vacuum gap above surface [sigma]
variable    steps_approach index 10000 # steps before impact (approach phase)
variable    steps_impact  index 80000  # steps during and after impact
variable    thermo_freq index 50       # thermo output frequency [steps]
variable    dump_freq   index 100      # trajectory dump frequency [steps]

# --- Derived variables --------------------------------------------------------
variable    vz0     equal -${v0}*cos(${angle}*PI/180.0)   # normal component (<0 = downward)
variable    vx0     equal  ${v0}*sin(${angle}*PI/180.0)   # tangential component

# --- Read equilibrated surface ------------------------------------------------
read_restart    restart.equilibrated

# Get surface top z-position (approximate from lattice params in equilibrate)
# Lattice a0=1.5496, Nz=6 layers -> top ~ 6*a0 ~ 9.3 sigma
variable    z_surf_top  equal 9.3      # approximate top of surface [sigma]
variable    z_proj_init equal $(v_z_surf_top + v_z_gap)  # initial projectile z

# --- Add projectile atom ------------------------------------------------------
# Atom type 2: projectile (same LJ parameters for homoatomic impact)
# Center of surface in x,y
variable    Lx  equal xhi-xlo
variable    Ly  equal yhi-ylo
variable    x_center equal $(v_Lx/2.0)
variable    y_center equal $(v_Ly/2.0)

create_atoms    2 single ${x_center} ${y_center} ${z_proj_init} units box

mass            2 1.0   # same mass as surface atoms (Ar-Ar)

# --- Interatomic potential ----------------------------------------------------
# LJ 12-6 for all pairs (homoatomic Argon)
# Projectile-surface interaction: same LJ parameters
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5    # surface-surface
pair_coeff      1 2 1.0 1.0 2.5    # surface-projectile (Lorentz-Berthelot mixing)
pair_coeff      2 2 1.0 1.0 2.5    # projectile-projectile (irrelevant, single atom)

pair_modify     tail yes

# --- Re-define groups after read_restart + new atom --------------------------
# NOTE: read_restart does NOT restore group definitions
variable    Nz_slab     equal 6
variable    a0          equal 1.5496
variable    Nz_slab_m1  equal ${Nz_slab}-1

region          reg_fixed  block INF INF INF INF 0               2               units lattice
region          reg_thermo block INF INF INF INF 2               ${Nz_slab_m1}   units lattice
region          reg_free   block INF INF INF INF ${Nz_slab_m1}   ${Nz_slab}      units lattice

group           surface    type 1
group           projectile type 2
group           fixed_atoms  region reg_fixed
group           thermo_atoms region reg_thermo
group           free_surface region reg_free
group           mobile       subtract surface fixed_atoms

# --- Apply projectile initial velocity ----------------------------------------
velocity        projectile set ${vx0} 0.0 ${vz0} units box

# --- Fixes --------------------------------------------------------------------
fix     f_freeze    fixed_atoms   setforce 0.0 0.0 0.0
fix     f_nvt       thermo_atoms  nvt temp ${T_target} ${T_target} ${T_damp}
fix     f_nve_surf  free_surface  nve
fix     f_nve_proj  projectile    nve   # projectile: microcanonical (no thermostat)

# --- Computes -----------------------------------------------------------------
compute T_surface   mobile      temp
compute T_full      all         temp

# Projectile position and velocity
compute proj_pos    projectile  reduce ave x y z
compute proj_vel    projectile  reduce ave vx vy vz
compute proj_ke     projectile  ke

# Surface kinetic energy (convert to temperature rise)
compute surf_ke     mobile      ke
compute surf_pe     all         pe

# Per-atom potential energy to detect surface disturbance
compute pe_atom     all         pe/atom


# --- Variables for real-time monitoring ---------------------------------------
variable time       equal step*dt
variable proj_z     equal c_proj_pos[3]
variable proj_vx    equal c_proj_vel[1]
variable proj_vz    equal c_proj_vel[3]
variable proj_ke_v  equal c_proj_ke
variable T_surf_v   equal c_T_surface

# Distance from surface top (contact criterion)
variable d_contact  equal v_proj_z-v_z_surf_top

# Detect rebound: projectile moving upward and above surface
variable rebounded  equal (v_proj_vz>0)&&(v_proj_z>v_z_surf_top)

# --- Thermo output ------------------------------------------------------------
timestep    ${dt}
thermo      ${thermo_freq}
thermo_style custom step time v_proj_z v_proj_vz v_proj_ke_v v_T_surf_v &
             v_d_contact etotal ke pe
thermo_modify norm no lost warn

# --- Trajectory dump ----------------------------------------------------------
dump    d_impact all custom ${dump_freq} dump.impact.lammpstrj &
        id type x y z vx vy vz c_pe_atom
dump_modify d_impact sort id

# --- Rebound data (high-frequency projectile tracking) -----------------------
fix     f_proj_track projectile print 10 &
        "${time} ${proj_z} ${proj_vx} ${proj_vz} ${proj_ke_v} ${T_surf_v} ${d_contact}" &
        file rebound_data.dat title "# time z vx vz ke_proj T_surf d_contact" &
        screen no

# --- Approach phase: let projectile approach surface at constant v0 -----------
# (No thermostat on projectile; it moves freely under gravity of potential)
run     ${steps_approach}

# --- Impact + rebound phase --------------------------------------------------
# Run until projectile has clearly rebounded (or max steps)
run     ${steps_impact}

# --- Post-run analysis --------------------------------------------------------
# Final projectile velocity for COR calculation
variable    vf_z    equal c_proj_vel[3]
variable    COR     equal abs(v_vf_z)/abs(v_vz0)
# Note: v_vz0 is negative (downward); abs() ensures positive COR

print "============================================="
print "IMPACT SIMULATION COMPLETE"
print "---------------------------------------------"
print "Incident velocity  v0_z = $(v_vz0) sigma/tau"
print "Impact angle            = ${angle} degrees"
print "Surface temperature     = ${T_target} eps/kB"
print "---------------------------------------------"
print "Final proj. velocity vf = $(v_vf_z) sigma/tau"
print "Coefficient of Restitution COR = $(v_COR)"
print "Energy dissipated dE = $(0.5*(v_v0*v_v0 - v_vf_z*v_vf_z)) eps"
print "Final surface temperature = $(c_T_surface) eps/kB"
print "============================================="

write_data  data.after_impact
